From 6452a764e546a1ad9141e4caee16a14829deb908 Mon Sep 17 00:00:00 2001
From: Liubomyr Kozak <liubomyr_kozak@epam.com>
Date: Tue, 4 Aug 2026 23:45:23 +0300
Subject: [PATCH] feature-widget-dashboard: card dashboard layout + scripts

---
 index.html   | 43 ++++++++++++++++++++++++++++++-------------
 package.json |  4 +++-
 2 files changed, 33 insertions(+), 14 deletions(-)

diff --git a/index.html b/index.html
index cdc6c7d..516a88e 100644
--- a/index.html
+++ b/index.html
@@ -2,25 +2,42 @@
 <html lang="en">
 <head>
   <meta charset="utf-8" />
-  <title>Loki demo-frontend</title>
+  <title>Loki demo-frontend (dashboard)</title>
   <style>
-    body { font-family: system-ui, sans-serif; max-width: 560px; margin: 4rem auto; padding: 0 1rem; }
-    #status { padding: 0.75rem 1rem; border-radius: 8px; background: #f2f2f2; white-space: pre-wrap; }
+    body { font-family: system-ui, sans-serif; max-width: 720px; margin: 4rem auto; padding: 0 1rem; }
+    .cards { display: flex; gap: 1rem; flex-wrap: wrap; }
+    .card { flex: 1 1 220px; padding: 1rem 1.25rem; border-radius: 10px; background: #f2f2f2; border: 1px solid #ddd; }
+    .card h2 { margin: 0 0 0.5rem; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.03em; color: #555; }
+    .card pre { margin: 0; white-space: pre-wrap; }
   </style>
 </head>
 <body>
-  <h1>demo-frontend</h1>
+  <h1>demo-frontend (dashboard)</h1>
   <p>Static page served by a zero-dependency Node server. Pings <code>demo-backend</code> on load.</p>
-  <div id="status">calling demo-backend...</div>
+  <div class="cards">
+    <div class="card">
+      <h2>Backend status</h2>
+      <pre id="status">calling demo-backend...</pre>
+    </div>
+    <div class="card">
+      <h2>Last ping</h2>
+      <pre id="lastPing">-</pre>
+    </div>
+  </div>
   <script>
-    fetch('http://localhost:4001')
-      .then((r) => r.json())
-      .then((data) => {
-        document.getElementById('status').textContent = JSON.stringify(data, null, 2);
-      })
-      .catch((err) => {
-        document.getElementById('status').textContent = 'demo-backend not reachable: ' + err.message;
-      });
+    function ping() {
+      fetch('http://localhost:4001')
+        .then((r) => r.json())
+        .then((data) => {
+          document.getElementById('status').textContent = JSON.stringify(data, null, 2);
+          document.getElementById('lastPing').textContent = new Date().toISOString();
+        })
+        .catch((err) => {
+          document.getElementById('status').textContent = 'demo-backend not reachable: ' + err.message;
+          document.getElementById('lastPing').textContent = new Date().toISOString();
+        });
+    }
+    ping();
   </script>
 </body>
 </html>
diff --git a/package.json b/package.json
index a560e9d..7bf912b 100644
--- a/package.json
+++ b/package.json
@@ -5,6 +5,8 @@
   "description": "Loki demo app: minimal zero-dependency static HTML server.",
   "main": "server.js",
   "scripts": {
-    "start": "node server.js"
+    "start": "node server.js",
+    "preview": "node server.js",
+    "watch": "node server.js"
   }
 }
-- 
