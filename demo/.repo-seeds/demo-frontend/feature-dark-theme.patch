From 7c5e7bdbb4faf43e3b673bddfcfbd9d709f74b5e Mon Sep 17 00:00:00 2001
From: Liubomyr Kozak <liubomyr_kozak@epam.com>
Date: Tue, 4 Aug 2026 23:45:00 +0300
Subject: [PATCH] feature-dark-theme: dark theme UI + dark script

---
 index.html   | 8 ++++----
 package.json | 3 ++-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/index.html b/index.html
index cdc6c7d..be3945c 100644
--- a/index.html
+++ b/index.html
@@ -2,14 +2,14 @@
 <html lang="en">
 <head>
   <meta charset="utf-8" />
-  <title>Loki demo-frontend</title>
+  <title>Loki demo-frontend (dark theme)</title>
   <style>
-    body { font-family: system-ui, sans-serif; max-width: 560px; margin: 4rem auto; padding: 0 1rem; }
-    #status { padding: 0.75rem 1rem; border-radius: 8px; background: #f2f2f2; white-space: pre-wrap; }
+    body { font-family: system-ui, sans-serif; max-width: 560px; margin: 4rem auto; padding: 0 1rem; background: #121212; color: #f0f0f0; }
+    #status { padding: 0.75rem 1rem; border-radius: 8px; background: #2a2a2a; color: #f0f0f0; white-space: pre-wrap; }
   </style>
 </head>
 <body>
-  <h1>demo-frontend</h1>
+  <h1>demo-frontend (dark theme)</h1>
   <p>Static page served by a zero-dependency Node server. Pings <code>demo-backend</code> on load.</p>
   <div id="status">calling demo-backend...</div>
   <script>
diff --git a/package.json b/package.json
index a560e9d..d43cdbc 100644
--- a/package.json
+++ b/package.json
@@ -5,6 +5,7 @@
   "description": "Loki demo app: minimal zero-dependency static HTML server.",
   "main": "server.js",
   "scripts": {
-    "start": "node server.js"
+    "start": "node server.js",
+    "dark": "node server.js"
   }
 }
-- 
