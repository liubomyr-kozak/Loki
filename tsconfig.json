{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    "types": [
      "node"
    ],
    "rootDir": "app",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "app/backend",
    "app/shared"
  ],
  "exclude": [
    "app/**/*.test.ts",
    "app/**/__checks__/**"
  ]
}
