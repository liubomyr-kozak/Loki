  "private": true,
  "scripts": {
    "dev": "yarn tauri dev",
    "cli": "ts-node app/backend/index.ts",
    "ui:dev": "vite",
    "ui:build": "yarn ui:typecheck && vite build",
    "server:build": "tsc -p .",
    "server:build:packaged": "node scripts/build-packaged-server.js",
    "tauri": "cd app && tauri",
    "demo:init": "node scripts/init-demo-repos.js",
    "doctor": "node scripts/doctor.js",
    "doctor:strict": "node scripts/doctor.js --strict",
    "desktop:dev": "yarn dev",
    "desktop:build": "yarn build",
    "prepare": "husky",
    "start": "yarn dev",
    "config:migrate": "ts-node app/backend/config/migrateLegacyConfig.ts",
    "backend:dev": "ts-node app/backend/server.ts",
    "build": "yarn tauri build",
    "desktop:prepare": "yarn doctor:strict && yarn server:build && yarn server:build:packaged",
    "build:assets": "yarn desktop:prepare && yarn node:bundle && yarn ui:build",
    "clean": "node scripts/clean.js",
    "ui:typecheck": "tsc -p app/tsconfig.json --noEmit",
    "test": "vitest run",
    "node:bundle": "node scripts/bundle-node-runtime.js"
  },
